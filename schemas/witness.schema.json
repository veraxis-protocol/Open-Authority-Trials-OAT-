{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veraxis.io/oat/schemas/witness/1",
  "title": "OAT candidate witness",
  "description": "A candidate witness. The claimed_evaluation is an adversary-side claim and is recomputed by the verifier, never trusted.",
  "type": "object",
  "required": ["witness_form", "run_mode", "claim_bearing_use", "scenario_id", "boundary_id", "manifest_digest", "falsifier", "adversary", "search", "trace", "trace_digest", "claimed_evaluation"],
  "properties": {
    "witness_form": { "const": "oat-witness/1" },
    "canonical_form": { "const": "oat-canonical-json/1" },
    "run_mode": { "const": "METHOD_DEVELOPMENT_ONLY" },
    "claim_bearing_use": { "const": "PROHIBITED" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "boundary_id": { "type": "string", "minLength": 1 },
    "manifest_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "falsifier": {
      "type": "object",
      "required": ["id", "version", "digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "adversary": {
      "type": "object",
      "required": ["id", "version", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["local-deterministic", "provider"] }
      }
    },
    "search": {
      "type": "object",
      "required": ["candidates_explored", "selected_candidate_index", "transcript"],
      "properties": {
        "candidates_explored": { "type": "integer", "minimum": 1 },
        "selected_candidate_index": { "type": "integer", "minimum": 0 },
        "transcript": {
          "type": "array",
          "minItems": 1,
          "description": "Every candidate the adversary proposed, in enumeration order.",
          "items": {
            "type": "object",
            "required": ["index", "variation", "counterexample", "trace_digest"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "variation": { "type": "object" },
              "authority_effective_at_commit": { "type": "string", "enum": ["ACTIVE", "REVOKED"] },
              "counterexample": { "type": "boolean" },
              "trace_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            }
          }
        }
      }
    },
    "trace": { "$ref": "https://veraxis.io/oat/schemas/observable-trace/1" },
    "trace_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "claimed_evaluation": {
      "type": "object",
      "required": ["counterexample", "predicate_trace"],
      "properties": {
        "counterexample": { "type": "boolean" },
        "predicate_trace": { "type": "array", "minItems": 1 }
      }
    }
  }
}
